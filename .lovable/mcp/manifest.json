  "mcp": {
    "server": {
      "name": "panda-os-mcp",
      "version": "0.1.0",
      "title": "Panda OS"
    },
    "tools": [
      {
        "name": "add_expense",
        "title": "Registrar gasto",
        "description": "Registra un gasto en Panda OS para el usuario autenticado.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "amount": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Monto en MXN"
            },
            "category": {
              "type": "string",
              "description": "Categoría (ej. comida, transporte, salud)"
            },
            "payment_method": {
              "default": "cash",
              "description": "Método de pago",
              "type": "string",
              "enum": [
                "cash",
                "debit",
                "credit",
                "transfer",
                "mercadopago",
                "other"
              ]
            },
            "date": {
              "description": "Fecha YYYY-MM-DD (default hoy CDMX)",
              "type": "string"
            },
            "note": {
              "description": "Nota corta",
              "type": "string"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "amount",
            "category"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "add_income",
        "title": "Registrar ingreso",
        "description": "Registra un ingreso (kind=income) en finanzas.",
        "annotations": {
          "readOnlyHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "amount": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "category": {
              "default": "ingreso",
              "type": "string"
            },
            "date": {
              "type": "string"
            },
            "note": {
              "type": "string"
            }
          },
          "required": [
            "amount"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_recent_expenses",
        "title": "Listar gastos recientes",
        "description": "Devuelve los gastos más recientes con opción de filtrar por categoría.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "category": {
              "type": "string"
            },
            "limit": {
              "default": 20,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "add_note",
        "title": "Crear nota",
        "description": "Crea una nota rápida en Panda OS.",
        "annotations": {
          "readOnlyHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "content": {
              "default": "",
              "type": "string"
            },
            "category": {
              "description": "Categoría / carpeta",
              "type": "string"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "importance": {
              "default": "normal",
              "type": "string",
              "enum": [
                "low",
                "normal",
                "high"
              ]
            }
          },
          "required": [
            "title"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_notes",
        "title": "Listar notas",
