              "minimum": 1,
              "maximum": 5
            },
            "pain": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "note": {
              "type": "string"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "log_sleep",
        "title": "Registrar sueño",
        "description": "Registra (upsert) sueño para una fecha.",
