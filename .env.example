# ============================================================
# VARIABLES DE ENTORNO — Panda's LIFE OS (versión portable)
# ============================================================
# Copia este archivo como `.env` y llena tus propias credenciales.
# No commitees el .env real al repo.
#
# Todo lo que empieza con VITE_ se expone al frontend (build).
# El resto es solo para SSR / servidor.

# ---------- SUPABASE (tu proyecto propio) ----------
VITE_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOi...ANON_KEY"
VITE_SUPABASE_PROJECT_ID="xxxxxxxxxxxx"

# Espejos server-side (mismo valor)
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
SUPABASE_PUBLISHABLE_KEY="eyJhbGciOi...ANON_KEY"
SUPABASE_PROJECT_ID="xxxxxxxxxxxx"

# Clave de servicio (SOLO servidor, nunca frontend)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi...SERVICE_ROLE"

# ---------- IA — OpenAI directo ----------
# Se usa dentro de las edge functions ai-* (chat, resumen, clasificación…)
OPENAI_API_KEY="sk-proj-..."

# ---------- Notificaciones Push — OneSignal ----------
ONESIGNAL_APP_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
ONESIGNAL_REST_API_KEY="os_v2_..."

# ---------- Telegram Bot (opcional) ----------
TELEGRAM_API_KEY="123456789:ABC..."

# ---------- Cron seguro ----------
# Cadena aleatoria (openssl rand -hex 32) — se usa como header x-cron-secret
# en las rutas /api/public/hooks/* que los cron jobs invocan.
CRON_SECRET="genera_una_cadena_larga_aleatoria_aqui"

# ---------- Push Web VAPID (legacy, opcional si NO usas OneSignal) ----------
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:tu@correo.com"

# ---------- SMS Twilio (opcional) ----------
TWILIO_API_KEY=""
TWILIO_FROM=""
